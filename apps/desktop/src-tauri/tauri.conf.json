{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onera",
  "version": "0.1.0",
  "identifier": "com.onera.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter onera-desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter onera-desktop build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Onera",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Game",
    "shortDescription": "A Linux-first, game-agnostic mod manager",
    "longDescription": "Onera installs, verifies and removes game mods transactionally, with full ownership history and crash recovery.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "p7zip-full"],
        "files": {
          "/usr/lib/onera/onera-nmhost": "../../../target/release/onera-nmhost",
          "/usr/share/onera/native-messaging/com.onera.host.json": "../../../packaging/com.onera.host.json"
        }
      }
    }
  }
}
